<Window x:Class="DiscordVoiceWidget.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord Voice Widget - Configurações"
        ThemeMode="System"
        MinWidth="400"
        MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <!--
        Layout responsivo (ver SettingsWindow.xaml.cs, ApplyColumns):
        - largura >= 760: duas colunas (LeftColumn | RightColumn);
        - mais estreita: RightColumn desce para baixo da LeftColumn;
        - o conteudo rola; o rodape com "Fechar" fica sempre visivel.
    -->

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="FirstSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ColumnsGrid" Margin="24,16,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- =========================== Coluna esquerda =========================== -->
                <StackPanel x:Name="LeftColumn">

                    <TextBlock Text="Posição" Style="{StaticResource FirstSectionHeader}" />

                    <ComboBox x:Name="MonitorCombo" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="Barra do monitor secundário, ao lado do relógio" Tag="Secondary" />
                        <ComboBoxItem Content="Barra do monitor principal, ao lado da bandeja" Tag="Primary" />
                        <ComboBoxItem Content="Barras dos dois monitores" Tag="Both" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Jogos em tela cheia cobrem a barra do monitor principal. Sem segundo monitor, o widget usa a principal." />

                    <TextBlock Text="Visibilidade" Style="{StaticResource SectionHeader}" />

                    <CheckBox x:Name="HideNotInCallCheck"
                              Content="Esconder quando eu não estiver em uma call"
                              Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Na barra, o widget fica dentro da própria barra de tarefas: um jogo em tela cheia que cubra a barra cobre o widget junto." />

                    <TextBlock Text="Aparência" Style="{StaticResource SectionHeader}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tamanho dos avatares" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="AvatarSizeCombo" Grid.Column="1" MinWidth="160" SelectionChanged="OnChanged">
                            <ComboBoxItem Content="Pequeno" Tag="Small" />
                            <ComboBoxItem Content="Médio" Tag="Medium" />
                            <ComboBoxItem Content="Grande" Tag="Large" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Anel verde permanece aceso por" Style="{StaticResource RowLabel}" />
                        <TextBlock x:Name="ReleaseLabel" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Grid>
                    <Slider x:Name="ReleaseSlider"
                            Margin="0,6,0,0"
                            Minimum="100" Maximum="1000"
                            TickFrequency="50" IsSnapToTickEnabled="True"
                            ValueChanged="OnReleaseChanged" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Tempo depois que a pessoa para de falar. Baixo pisca nas pausas; alto deixa o anel aceso depois do silêncio." />
                </StackPanel>

                <!-- =========================== Coluna direita ============================ -->
                <StackPanel x:Name="RightColumn" Grid.Row="1">

                    <TextBlock x:Name="OverlayHeader" Text="Overlay nos jogos" Style="{StaticResource SectionHeader}" />

                    <CheckBox x:Name="OverlayCheck"
                              Content="Mostrar o widget por cima dos jogos"
                              Checked="OnChanged" Unchecked="OnChanged" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Atalho para ligar/desligar" Style="{StaticResource RowLabel}" />
                        <TextBox x:Name="ToggleHotkeyBox" Grid.Column="1" MinWidth="200"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 PreviewKeyDown="OnHotkeyKeyDown"
                                 GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur" />

                        <TextBlock Grid.Row="2" Text="Atalho para mover" Style="{StaticResource RowLabel}" />
                        <TextBox x:Name="MoveHotkeyBox" Grid.Row="2" Grid.Column="1" MinWidth="200"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 PreviewKeyDown="OnHotkeyKeyDown"
                                 GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Clique no campo e aperte a combinação (com Ctrl, Alt, Shift ou Win). Backspace desliga; Esc cancela." />

                    <Button Content="Posicionar o overlay agora"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Click="OnMoveOverlayClick" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Ligado, aparece enquanto você estiver em call — sem detectar jogo nem tela cheia. Fica por cima de jogos em tela cheia sem bordas ou em janela (não em tela cheia exclusiva). Janela separada, sem nada injetado no jogo; fora do modo mover os cliques atravessam." />

                    <TextBlock Text="Sistema" Style="{StaticResource SectionHeader}" />

                    <CheckBox x:Name="StartupCheck"
                              Content="Iniciar com o Windows"
                              Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                    <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" />

                    <!-- WrapPanel: em janela estreita o segundo botao desce em vez de cortar. -->
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Abrir pasta de logs" Margin="0,0,8,8" Click="OnOpenLogsClick" />
                        <Button Content="Abrir pasta de configuração" Margin="0,0,8,8" Click="OnOpenConfigClick" />
                    </WrapPanel>

                    <TextBlock Text="Discord" Style="{StaticResource SectionHeader}" />

                    <Button Content="Trocar app do Discord (ID e secret)"
                            HorizontalAlignment="Left"
                            Click="OnChangeCredentialsClick" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Use se trocou o Client Secret no portal ou se o Discord recusou a autorização." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Rodape fixo: "Fechar" alcancavel sem rolar. -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#20808080" Padding="24,12">
            <Button Content="Fechar"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    IsDefault="True" IsCancel="True"
                    Click="OnCloseClick" />
        </Border>
    </Grid>
</Window>
