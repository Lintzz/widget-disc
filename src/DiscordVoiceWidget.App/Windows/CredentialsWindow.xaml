<Window x:Class="DiscordVoiceWidget.App.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord Voice Widget - Conectar ao Discord"
        ThemeMode="System"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,16,24,16">
            <TextBlock Text="Conectar ao seu app do Discord" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="O widget lê a sua call através de um app seu no Discord. Leva uns 5 minutos e só é feito uma vez." />

            <!-- Passo a passo -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="1." Style="{StaticResource StepNumber}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource StepText}"
                               Text="Abra o Developer Portal e clique em New Application (o nome pode ser qualquer um)." />
                    <Button Content="Abrir o Developer Portal" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OnOpenPortalClick" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="2." Style="{StaticResource StepNumber}" />
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Style="{StaticResource StepText}"
                               Text="Em OAuth2 → Redirects, clique em Add Redirect, cole o endereço abaixo e salve. Exatamente assim: https e sem barra no final." />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RedirectBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                        <Button x:Name="CopyRedirectButton" Grid.Column="1" Content="Copiar" MinWidth="88"
                                Margin="8,0,0,0" Click="OnCopyRedirectClick" />
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="3." Style="{StaticResource StepNumber}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource StepText}"
                           Text="Em General Information, copie o Application ID e cole abaixo." />

                <TextBlock Grid.Row="6" Text="4." Style="{StaticResource StepNumber}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource StepText}"
                           Text="Em OAuth2, clique em Reset Secret, copie o Client Secret e cole abaixo. Ele só aparece uma vez." />
            </Grid>

            <!-- Campos -->
            <TextBlock Text="Application ID" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
            <TextBox x:Name="ClientIdBox" TextChanged="OnInputChanged" />

            <TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="SecretBox" PasswordChanged="OnInputChanged" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="Fica salvo só neste computador. Não compartilhe o seu Client Secret com ninguém." />

            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="#E5484D" FontWeight="SemiBold" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#20808080" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" MinWidth="96" IsCancel="True" />
                <Button Content="Salvar e conectar" MinWidth="96" Margin="8,0,0,0" IsDefault="True"
                        Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
