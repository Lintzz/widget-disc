<Window x:Class="DiscordVoiceWidget.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiscordVoiceWidget.App"
        Title="Discord Voice Widget - Overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Margem fixa: da lugar a moldura do modo mover sem mudar a posicao da pilula. -->
        <Grid Margin="4">
            <Rectangle x:Name="MoveFrame"
                       Margin="-4"
                       RadiusX="21" RadiusY="21"
                       Stroke="#5865F2"
                       StrokeThickness="2"
                       StrokeDashArray="3 2"
                       Fill="#265865F2"
                       Visibility="Collapsed" />

            <local:VoiceWidgetView x:Name="View" />
        </Grid>

        <Border x:Name="MoveHint"
                Grid.Row="1"
                Margin="4,2,4,0"
                HorizontalAlignment="Left"
                Padding="8,3"
                CornerRadius="8"
                Background="#E62B2D31"
                Visibility="Collapsed">
            <TextBlock x:Name="MoveHintText" Foreground="#DBDEE1" FontSize="11" />
        </Border>
    </Grid>
</Window>
